# SPA fallback - 所有非API、非静态资源请求回退到200.html
# 使用 200 重写（不是重定向），让SvelteKit客户端路由处理

# API请求 - 不重写
/api/* /api/:splat 200

# 静态资源 - 不重写
/_app/* /_app/:splat 200
/static/* /static/:splat 200
/favicon.png /favicon.png 200
/icon.svg /icon.svg 200
/icon-192.png /icon-192.png 200
/icon-512.png /icon-512.png 200
/manifest.json /manifest.json 200
/robots.txt /robots.txt 200
/sw.js /sw.js 200
/blocked.html /blocked.html 200

# 前端路由 - 回退到200.html让SvelteKit处理
/* /200.html 200
